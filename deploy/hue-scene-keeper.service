# systemd unit for hue-scene-keeper.
#
# Install (run go:install as yourself, not under sudo: it builds as you and
# elevates only the copy into /usr/local/bin, whereas sudo would re-run the
# compiler as root and leave root-owned entries in your Go caches):
#   go tool mage go:install
#   go tool mage installConfig
#   sudo useradd --system --home-dir /var/lib/hue-scene-keeper --shell /usr/sbin/nologin hue
#   sudo install -d -o hue -g hue -m0700 /var/lib/hue-scene-keeper
#   sudo install -m0644 deploy/hue-scene-keeper.service /etc/systemd/system/
#
# Pair BEFORE starting the service, as the service user and with the same
# --state path the unit uses. Paths are passed explicitly rather than through
# XDG_* so that this command and the unit cannot drift apart:
#
#   sudo -u hue /usr/local/bin/hue-scene-keeper \
#       --state /var/lib/hue-scene-keeper/credentials.json auth
#
# Then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now hue-scene-keeper
#   journalctl -u hue-scene-keeper -f
#
# Enabling before pairing is not fatal but is not self-healing either: with no
# credentials `run` exits at once, and Restart=always at RestartSec=5s burns
# StartLimitBurst in under a minute, leaving the unit failed with
# "start-request-repeated-too-quickly". systemd will not start it again, even
# once the credentials exist, until the counter is cleared:
#   sudo systemctl reset-failed hue-scene-keeper
#   sudo systemctl start hue-scene-keeper
#
# The config file is the other way into that state, which is why installConfig
# is in the list above. Run by hand the daemon needs no config file at all, but
# this unit *names* one, and an explicitly-given --config that does not exist is
# a fatal error rather than a fallback to the defaults - it is what catches a
# typo in a hand-typed path. What installConfig writes is entirely comments, so
# it selects nothing and every default stays the daemon's, but the file has to
# be there. Deleting it later fails the unit exactly as missing credentials do,
# with the same cure.

[Unit]
Description=Keep Philips Hue rooms in their all-day smart scene
After=network-online.target
Wants=network-online.target

# Do not restart-loop forever on an unrecoverable error such as missing
# credentials; fail visibly instead of filling the journal.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=hue
Group=hue
ExecStart=/usr/local/bin/hue-scene-keeper \
    --config /etc/hue-scene-keeper/config.yaml \
    --state /var/lib/hue-scene-keeper/credentials.json \
    run
Restart=always
RestartSec=5s

StateDirectory=hue-scene-keeper
StateDirectoryMode=0700
ConfigurationDirectory=hue-scene-keeper

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
